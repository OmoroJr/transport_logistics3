{
 "actions": [],
 "autoname": "format:TYRE-MOV-{#####}",
 "creation": "2026-01-01 00:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "tyre",
  "movement_type",
  "date",
  "column_break_1",
  "vehicle_type",
  "truck",
  "trailer",
  "column_break_vehicle",
  "is_spare",
  "axle_type",
  "axle_number",
  "side",
  "position",
  "odometer_reading",
  "section_break_cost",
  "cost",
  "vendor",
  "column_break_cost",
  "remarks",
  "company",
  "journal_entry",
  "section_break_approval",
  "manager_approval_status",
  "column_break_approval",
  "approved_by",
  "approved_on",
  "approval_remarks"
 ],
 "fields": [
  {
   "fieldname": "tyre",
   "fieldtype": "Link",
   "label": "Tyre",
   "options": "Tyre",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "movement_type",
   "fieldtype": "Select",
   "label": "Movement Type",
   "options": "Fitted\nRemoved\nRotated\nRetreaded\nScrapped",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "vehicle_type",
   "fieldtype": "Select",
   "label": "Vehicle Type",
   "options": "\nTruck\nTrailer",
   "mandatory_depends_on": "eval:[\"Fitted\",\"Rotated\"].includes(doc.movement_type)"
  },
  {
   "fieldname": "truck",
   "fieldtype": "Link",
   "label": "Truck",
   "options": "Truck",
   "in_list_view": 1,
   "mandatory_depends_on": "eval:doc.vehicle_type==\"Truck\" && [\"Fitted\",\"Rotated\"].includes(doc.movement_type)"
  },
  {
   "fieldname": "trailer",
   "fieldtype": "Link",
   "label": "Trailer",
   "options": "Trailer",
   "mandatory_depends_on": "eval:doc.vehicle_type==\"Trailer\" && [\"Fitted\",\"Rotated\"].includes(doc.movement_type)"
  },
  {
   "fieldname": "column_break_vehicle",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "is_spare",
   "fieldtype": "Check",
   "label": "This is the Spare",
   "default": "0",
   "description": "Tick if this tyre is being mounted as the vehicle's spare, rather than on a numbered axle position."
  },
  {
   "fieldname": "axle_type",
   "fieldtype": "Select",
   "label": "Axle Type",
   "options": "\nFront\nRear",
   "depends_on": "eval:doc.vehicle_type==\"Truck\" && !doc.is_spare",
   "mandatory_depends_on": "eval:doc.vehicle_type==\"Truck\" && !doc.is_spare && [\"Fitted\",\"Rotated\"].includes(doc.movement_type)",
   "description": "Trailer axles aren't split into Front/Rear, so this only applies to trucks."
  },
  {
   "fieldname": "axle_number",
   "fieldtype": "Int",
   "label": "Axle Number",
   "depends_on": "eval:!doc.is_spare",
   "mandatory_depends_on": "eval:!doc.is_spare && [\"Fitted\",\"Rotated\"].includes(doc.movement_type)",
   "description": "1-indexed from the front of that axle group, e.g. Rear Axle 2 of 3. Must be within the vehicle's configured axle count."
  },
  {
   "fieldname": "side",
   "fieldtype": "Select",
   "label": "Side",
   "options": "\nLeft\nRight\nLeft Outer\nLeft Inner\nRight Outer\nRight Inner",
   "depends_on": "eval:!doc.is_spare",
   "mandatory_depends_on": "eval:!doc.is_spare && [\"Fitted\",\"Rotated\"].includes(doc.movement_type)"
  },
  {
   "fieldname": "position",
   "fieldtype": "Data",
   "label": "Position",
   "read_only": 1,
   "description": "Auto-generated readable label from the fields above, e.g. 'Rear Axle 2 - Left Outer' or 'Spare'."
  },
  {
   "fieldname": "odometer_reading",
   "fieldtype": "Float",
   "label": "Odometer Reading At Movement (Km)"
  },
  {
   "fieldname": "section_break_cost",
   "fieldtype": "Section Break",
   "label": "Cost (for Retreading)"
  },
  {
   "fieldname": "cost",
   "fieldtype": "Currency",
   "label": "Cost"
  },
  {
   "fieldname": "vendor",
   "fieldtype": "Data",
   "label": "Vendor"
  },
  {
   "fieldname": "column_break_cost",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "fetch_from": "truck.company",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "journal_entry",
   "fieldtype": "Link",
   "label": "Journal Entry",
   "options": "Journal Entry",
   "read_only": 1
  },
  {
   "fieldname": "section_break_approval",
   "fieldtype": "Section Break",
   "label": "Manager Approval",
   "depends_on": "eval:[\"Fitted\",\"Removed\"].includes(doc.movement_type)"
  },
  {
   "fieldname": "manager_approval_status",
   "fieldtype": "Select",
   "label": "Manager Approval Status",
   "options": "Not Required\nPending Approval\nApproved\nRejected",
   "default": "Not Required",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Fitting or removing a tyre (a tyre change) requires System Manager approval before this log can be submitted."
  },
  {
   "fieldname": "column_break_approval",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Approved/Rejected By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved/Rejected On",
   "read_only": 1
  },
  {
   "fieldname": "approval_remarks",
   "fieldtype": "Small Text",
   "label": "Approval Remarks",
   "read_only": 1
  }
 ],
 "is_submittable": 1,
 "index_web_pages_for_search": 1,
 "links": [],
 "modified": "2026-01-01 00:00:00",
 "modified_by": "Administrator",
 "module": "Transport Logistics",
 "name": "Tyre Movement Log",
 "naming_rule": "Expression",
 "owner": "Administrator",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Transport Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "submit": 1,
   "cancel": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Transport User",
   "read": 1,
   "write": 1,
   "create": 1,
   "submit": 1,
   "report": 1,
   "print": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
