{
 "actions": [],
 "autoname": "format:FUEL-{truck}-{#####}",
 "creation": "2026-01-01 00:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "truck",
  "source",
  "reason_for_fuelling",
  "truck_trip",
  "authority_to_load",
  "fuel_dispensing",
  "date",
  "driver",
  "column_break_1",
  "company",
  "section_break_odo",
  "previous_odometer",
  "odometer_reading",
  "distance_covered",
  "column_break_odo",
  "full_tank",
  "fuel_station",
  "section_break_qty",
  "fuel_qty_litres",
  "rate_per_litre",
  "column_break_qty",
  "total_amount",
  "fuel_efficiency_km_per_litre",
  "section_break_extra_fuel",
  "standard_fuel_litres",
  "extra_fuel_litres",
  "column_break_extra_fuel",
  "extra_fuel_reason",
  "remarks",
  "journal_entry",
  "section_break_approval",
  "manager_approval_status",
  "column_break_approval",
  "approved_by",
  "approved_on",
  "approval_remarks"
 ],
 "fields": [
  {
   "fieldname": "truck",
   "fieldtype": "Link",
   "label": "Truck",
   "options": "Truck",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "source",
   "fieldtype": "Select",
   "label": "Source",
   "options": "External Purchase\nInternal Bulk Dispensing",
   "default": "External Purchase",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "reason_for_fuelling",
   "fieldtype": "Select",
   "label": "Reason for Fuelling",
   "options": "For Trip\nYard / Standby\nGenerator\nOther",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "truck_trip",
   "fieldtype": "Link",
   "label": "Truck Trip",
   "options": "Truck Trip",
   "depends_on": "eval:doc.reason_for_fuelling=='For Trip'",
   "mandatory_depends_on": "eval:doc.reason_for_fuelling=='For Trip'",
   "description": "The trip this fuelling is for."
  },
  {
   "fieldname": "authority_to_load",
   "fieldtype": "Link",
   "label": "Authority to Load",
   "options": "Authority to Load",
   "depends_on": "eval:doc.reason_for_fuelling=='For Trip'",
   "mandatory_depends_on": "eval:doc.reason_for_fuelling=='For Trip'",
   "description": "Attach the Authority to Load issued for this trip. Must be submitted, for the same truck and trip, and have all checks passed."
  },
  {
   "fieldname": "fuel_dispensing",
   "fieldtype": "Link",
   "label": "Fuel Dispensing Record",
   "options": "Fuel Dispensing",
   "read_only": 1,
   "depends_on": "eval:doc.source=='Internal Bulk Dispensing'"
  },
  {
   "fieldname": "date",
   "fieldtype": "Date",
   "label": "Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "driver",
   "fieldtype": "Link",
   "label": "Driver",
   "options": "Employee",
   "fetch_from": "truck.assigned_driver"
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "fetch_from": "truck.company",
   "reqd": 1
  },
  {
   "fieldname": "section_break_odo",
   "fieldtype": "Section Break",
   "label": "Odometer"
  },
  {
   "fieldname": "previous_odometer",
   "fieldtype": "Float",
   "label": "Previous Odometer (Km)",
   "read_only": 1
  },
  {
   "fieldname": "odometer_reading",
   "fieldtype": "Float",
   "label": "Current Odometer Reading (Km)",
   "reqd": 1
  },
  {
   "fieldname": "distance_covered",
   "fieldtype": "Float",
   "label": "Distance Covered (Km)",
   "read_only": 1
  },
  {
   "fieldname": "column_break_odo",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "full_tank",
   "fieldtype": "Check",
   "label": "Full Tank",
   "default": "1"
  },
  {
   "fieldname": "fuel_station",
   "fieldtype": "Data",
   "label": "Fuel Station"
  },
  {
   "fieldname": "section_break_qty",
   "fieldtype": "Section Break",
   "label": "Fuel & Cost"
  },
  {
   "fieldname": "fuel_qty_litres",
   "fieldtype": "Float",
   "label": "Fuel Quantity (Litres)",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "rate_per_litre",
   "fieldtype": "Currency",
   "label": "Rate per Litre",
   "reqd": 1
  },
  {
   "fieldname": "column_break_qty",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_amount",
   "fieldtype": "Currency",
   "label": "Total Amount",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "fuel_efficiency_km_per_litre",
   "fieldtype": "Float",
   "label": "Fuel Efficiency (Km/Litre)",
   "read_only": 1,
   "precision": "2"
  },
  {
   "fieldname": "section_break_extra_fuel",
   "fieldtype": "Section Break",
   "label": "Extra Fuel (vs Route Standard)",
   "depends_on": "eval:doc.reason_for_fuelling=='For Trip'"
  },
  {
   "fieldname": "standard_fuel_litres",
   "fieldtype": "Float",
   "label": "Standard Fuel for Route (Litres)",
   "read_only": 1,
   "description": "Pulled from the trip's Route. Blank/zero means this route has no standard set, so no reason is required no matter how much fuel is logged."
  },
  {
   "fieldname": "extra_fuel_litres",
   "fieldtype": "Float",
   "label": "Extra Fuel Over Standard (Litres)",
   "read_only": 1
  },
  {
   "fieldname": "column_break_extra_fuel",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "extra_fuel_reason",
   "fieldtype": "Small Text",
   "label": "Reason for Extra Fuel",
   "depends_on": "eval:doc.extra_fuel_litres > 0",
   "description": "Required whenever the fuel logged for this trip exceeds the route's standard fuel amount."
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "journal_entry",
   "fieldtype": "Link",
   "label": "Journal Entry",
   "options": "Journal Entry",
   "read_only": 1
  },
  {
   "fieldname": "section_break_approval",
   "fieldtype": "Section Break",
   "label": "Manager Approval",
   "depends_on": "eval:doc.extra_fuel_litres > 0"
  },
  {
   "fieldname": "manager_approval_status",
   "fieldtype": "Select",
   "label": "Manager Approval Status",
   "options": "Not Required\nPending Approval\nApproved\nRejected",
   "default": "Not Required",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Extra Fuel (over the route standard) requires System Manager approval before this log can be submitted."
  },
  {
   "fieldname": "column_break_approval",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Approved/Rejected By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved/Rejected On",
   "read_only": 1
  },
  {
   "fieldname": "approval_remarks",
   "fieldtype": "Small Text",
   "label": "Approval Remarks",
   "read_only": 1
  }
 ],
 "is_submittable": 1,
 "index_web_pages_for_search": 1,
 "links": [],
