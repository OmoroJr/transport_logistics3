   "fieldname": "column_break_vehicle",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "odometer_reading",
   "fieldtype": "Float",
   "label": "Odometer Reading (Km)",
   "description": "Of the truck this tyre is currently fitted to, if applicable \u2014 useful for correlating wear rate against distance run."
  },
  {
   "fieldname": "section_break_depth",
   "fieldtype": "Section Break",
   "label": "Tread Depth"
  },
  {
   "fieldname": "tread_depth_mm",
   "fieldtype": "Float",
   "label": "Measured Tread Depth (mm)",
   "reqd": 1,
   "precision": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "minimum_required_mm",
   "fieldtype": "Float",
   "label": "Minimum Required (mm)",
   "precision": "1",
   "description": "Defaults from Transport Logistics Settings > Minimum Legal Tread Depth, but can be overridden per-inspection (e.g. a stricter internal standard for steer axles)."
  },
  {
   "fieldname": "column_break_depth",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Pass\nMarginal\nFail",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Computed automatically: Fail if at/below the minimum, Marginal if within 20% above it, otherwise Pass."
  },
  {
   "fieldname": "section_break_notes",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
