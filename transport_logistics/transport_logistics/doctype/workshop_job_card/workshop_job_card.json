   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Spare part issuance requires System Manager approval before this job card can be submitted (parts are only physically issued from the warehouse on submit)."
  },
  {
   "fieldname": "column_break_approval",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
