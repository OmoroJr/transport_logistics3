{
 "actions": [],
 "autoname": "format:TRIP-{truck}-{#####}",
 "creation": "2026-01-01 00:00:00",
 "doctype": "DocType",
 "engine": "InnoDB",
 "field_order": [
  "truck",
  "driver",
  "route",
  "trip_date",
  "status",
  "column_break_1",
  "company",
  "customer",
  "sales_order",
  "delivery_note",
  "pre_trip_fuel_log",
  "pre_trip_inspection",
  "section_break_route",
  "origin",
  "destination",
  "expected_delivery_datetime",
  "column_break_route",
  "start_odometer",
  "end_odometer",
  "distance_km",
  "section_break_rev",
  "revenue",
  "section_break_offload",
  "offload_status",
  "offload_datetime",
  "column_break_offload",
  "offload_odometer",
  "offloaded_by",
  "delivery_number",
  "delivery_delay_reason",
  "proof_of_delivery",
  "section_break_pod_auth",
  "pod_authenticated",
  "pod_authenticated_by",
  "pod_authenticated_on",
  "remarks",
  "section_break_approval",
  "new_driver_requested",
  "driver_change_reason",
  "manager_approval_status",
  "column_break_approval",
  "approved_by",
  "approved_on",
  "approval_remarks"
 ],
 "fields": [
  {
   "fieldname": "truck",
   "fieldtype": "Link",
   "label": "Truck",
   "options": "Truck",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "driver",
   "fieldtype": "Link",
   "label": "Driver",
   "options": "Employee",
   "fetch_from": "truck.assigned_driver"
  },
  {
   "fieldname": "route",
   "fieldtype": "Link",
   "label": "Route",
   "options": "Route",
   "description": "Optional: link a standard Route to auto-fill Origin/Destination and drive per-destination driver pay."
  },
  {
   "fieldname": "trip_date",
   "fieldtype": "Date",
   "label": "Trip Date",
   "reqd": 1,
   "default": "Today",
   "in_list_view": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Planned\nOngoing\nCompleted\nCancelled",
   "default": "Planned",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "fetch_from": "truck.company",
   "reqd": 1
  },
  {
   "fieldname": "customer",
   "fieldtype": "Link",
   "label": "Customer (if 3rd Party Haulage)",
   "options": "Customer"
  },
  {
   "fieldname": "sales_order",
   "fieldtype": "Link",
   "label": "Sales Order",
   "options": "Sales Order",
   "description": "If this haulage is against a Sales Order for the customer, link it here to auto-fill Revenue Earned from its Grand Total. Leave blank and enter Revenue manually if there's no Sales Order."
  },
  {
   "fieldname": "delivery_note",
   "fieldtype": "Link",
   "label": "Delivery Note",
   "options": "Delivery Note",
   "description": "Generated automatically from the linked Sales Order when this trip starts (status set to Ongoing), the same way a normal Sales flow produces a Delivery Note. Leave blank to have it auto-created, or link an existing submitted Delivery Note yourself (e.g. for a partial shipment). Locked once set, and the Delivery Number captured at offload must match it.",
   "mandatory_depends_on": "eval:doc.status==\"Ongoing\" || doc.status==\"Completed\""
  },
  {
   "fieldname": "pre_trip_fuel_log",
   "fieldtype": "Link",
   "label": "Pre-Trip Fuel Log",
   "options": "Truck Fuel Log",
   "description": "A Full Tank fuel log for this truck, dated on or before departure \u2014 required before the trip can start (status Ongoing). Confirms the truck was fueled up before leaving, reducing the risk of a highway breakdown from running dry. Locked once set.",
   "mandatory_depends_on": "eval:doc.status==\"Ongoing\" || doc.status==\"Completed\""
  },
  {
   "fieldname": "pre_trip_inspection",
   "fieldtype": "Link",
   "label": "Pre-Trip Inspection",
   "options": "Trip Pre Inspection",
   "description": "A Pass'd Trip Pre Inspection for this truck, dated on or before departure. Optional by default; becomes required before the trip can start (status Ongoing) if Transport Logistics Settings > Require Pre-Trip Inspection Before Departure is enabled. Locked once set."
  },
  {
   "fieldname": "section_break_route",
   "fieldtype": "Section Break",
   "label": "Route"
  },
  {
   "fieldname": "origin",
   "fieldtype": "Data",
   "label": "Origin",
   "fetch_from": "route.origin",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "destination",
   "fieldtype": "Data",
   "label": "Destination",
   "fetch_from": "route.destination",
   "fetch_if_empty": 1
  },
  {
   "fieldname": "expected_delivery_datetime",
   "fieldtype": "Datetime",
   "label": "Expected Delivery Date & Time",
   "description": "Promised delivery time to the customer, if tracked. Used by the Delivery Performance report to classify a trip as On-Time or Late once offloaded. Leave blank if this isn't tracked for this trip \u2014 it won't be counted as either."
  },
  {
   "fieldname": "column_break_route",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "start_odometer",
   "fieldtype": "Float",
   "label": "Start Odometer (Km)"
  },
  {
   "fieldname": "end_odometer",
   "fieldtype": "Float",
   "label": "End Odometer (Km)"
  },
  {
   "fieldname": "distance_km",
   "fieldtype": "Float",
   "label": "Distance (Km)",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_rev",
   "fieldtype": "Section Break",
   "label": "Revenue (Optional)"
  },
  {
   "fieldname": "revenue",
   "fieldtype": "Currency",
   "label": "Revenue Earned",
   "fetch_from": "sales_order.grand_total",
   "fetch_if_empty": 1,
   "read_only_depends_on": "eval:doc.sales_order",
   "description": "Auto-filled from the linked Sales Order's Grand Total. If no Sales Order is linked, enter the revenue for this trip manually."
  },
  {
   "fieldname": "section_break_offload",
   "fieldtype": "Section Break",
   "label": "Offloading (Empty Truck Tracking)"
  },
  {
   "fieldname": "offload_status",
   "fieldtype": "Select",
   "label": "Offload Status",
   "options": "Not Offloaded\nOffloaded",
   "default": "Not Offloaded",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "offload_datetime",
   "fieldtype": "Datetime",
   "label": "Offloaded At",
   "read_only": 1
  },
  {
   "fieldname": "column_break_offload",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "offload_odometer",
   "fieldtype": "Float",
   "label": "Odometer At Offload (Km)",
   "read_only": 1,
   "mandatory_depends_on": "eval:doc.offload_status==\"Offloaded\""
  },
  {
   "fieldname": "offloaded_by",
   "fieldtype": "Link",
   "label": "Offload Confirmed By",
   "options": "Employee",
   "read_only": 1,
   "mandatory_depends_on": "eval:doc.offload_status==\"Offloaded\""
  },
  {
   "fieldname": "delivery_number",
   "fieldtype": "Data",
   "label": "Delivery Number",
   "description": "Must match the Delivery Note recorded above (the document issued to the driver when the trip started) - transcribe it from the physical document in hand at offload. A mismatch is rejected: it means the driver is not returning proof against the original delivery.",
   "read_only": 1,
   "mandatory_depends_on": "eval:doc.offload_status==\"Offloaded\""
  },
  {
   "fieldname": "delivery_delay_reason",
   "fieldtype": "Small Text",
   "label": "Reason for Delay",
   "depends_on": "eval:doc.expected_delivery_datetime && doc.offload_datetime && doc.offload_datetime > doc.expected_delivery_datetime",
   "description": "Only relevant if this trip was offloaded later than the Expected Delivery Date & Time above."
  },
  {
   "fieldname": "proof_of_delivery",
   "fieldtype": "Attach",
   "label": "Proof of Delivery",
   "description": "Signed delivery note / POD document confirming the client received the load. Required before a trip can be marked Offloaded.",
   "read_only": 1,
   "mandatory_depends_on": "eval:doc.offload_status==\"Offloaded\""
  },
  {
   "fieldname": "section_break_pod_auth",
   "fieldtype": "Section Break",
   "label": "POD Authentication",
   "depends_on": "eval:doc.offload_status==\"Offloaded\""
  },
  {
   "fieldname": "pod_authenticated",
   "fieldtype": "Check",
   "label": "Proof of Delivery Authenticated",
   "default": "0",
   "read_only": 1,
   "description": "Set only via the 'Authenticate Proof of Delivery' action by an authorized user (Transport Manager) who has independently verified the scanned document and Delivery Number against the physical/client records. Cannot be set by the person who performed the offload."
  },
  {
   "fieldname": "pod_authenticated_by",
   "fieldtype": "Link",
   "label": "Authenticated By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "pod_authenticated_on",
   "fieldtype": "Datetime",
   "label": "Authenticated On",
   "read_only": 1
  },
  {
   "fieldname": "remarks",
   "fieldtype": "Small Text",
   "label": "Remarks"
  },
  {
   "fieldname": "section_break_approval",
   "fieldtype": "Section Break",
   "label": "Driver Change Approval",
   "description": "Once a trip already has a Driver assigned, swapping to a different Driver requires System Manager approval. Use the 'Request Driver Change' action instead of editing Driver directly."
  },
  {
   "fieldname": "new_driver_requested",
   "fieldtype": "Link",
   "label": "New Driver Requested",
   "options": "Employee",
   "read_only": 1,
   "description": "Set by 'Request Driver Change'. Applied to the Driver field only once a System Manager approves this request."
  },
  {
   "fieldname": "driver_change_reason",
   "fieldtype": "Small Text",
   "label": "Reason for Driver Change",
   "read_only": 1
  },
  {
   "fieldname": "manager_approval_status",
   "fieldtype": "Select",
   "label": "Manager Approval Status",
   "options": "Not Required\nPending Approval\nApproved\nRejected",
   "default": "Not Required",
   "read_only": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_approval",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "approved_by",
   "fieldtype": "Link",
   "label": "Approved/Rejected By",
   "options": "User",
   "read_only": 1
  },
  {
   "fieldname": "approved_on",
   "fieldtype": "Datetime",
   "label": "Approved/Rejected On",
   "read_only": 1
  },
  {
   "fieldname": "approval_remarks",
   "fieldtype": "Small Text",
   "label": "Approval Remarks",
   "read_only": 1
  }
 ],
 "index_web_pages_for_search": 1,
 "links": [],
 "modified": "2026-01-01 00:00:00",
 "modified_by": "Administrator",
 "module": "Transport Logistics",
 "name": "Truck Trip",
 "naming_rule": "Expression",
 "owner": "Administrator",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Transport Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "report": 1,
   "export": 1,
   "print": 1,
   "email": 1,
   "share": 1
  },
  {
   "role": "Transport User",
   "read": 1,
   "write": 1,
   "create": 1,
   "report": 1,
   "print": 1
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1
}
