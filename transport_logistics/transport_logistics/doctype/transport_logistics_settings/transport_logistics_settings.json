 "fields": [
  {
   "fieldname": "section_gl",
   "fieldtype": "Section Break",
   "label": "GL Posting (Optional)"
  },
  {
   "fieldname": "enable_gl_posting",
   "fieldtype": "Check",
   "label": "Post Costs to General Ledger",
   "default": "0",
   "description": "When enabled, submitting a Fuel Log, Maintenance Log, Truck Expense, or Tyre Retread will automatically create and submit a Journal Entry."
  },
  {
   "fieldname": "default_cost_center",
   "fieldtype": "Link",
   "label": "Default Cost Center",
   "options": "Cost Center"
  },
  {
   "fieldname": "default_payment_account",
   "fieldtype": "Link",
   "label": "Default Payment/Credit Account",
   "options": "Account",
   "description": "e.g. Cash, Bank, or a Creditors account. This is credited on every auto-posted entry."
  },
  {
   "fieldname": "column_break_gl",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "fuel_expense_account",
   "fieldtype": "Link",
   "label": "Fuel Expense Account",
   "options": "Account"
  },
